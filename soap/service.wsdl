<?xml version="1.0" encoding="UTF-8"?>
<definitions name="OrderService"
             targetNamespace="http://www.examples.com/wsdl/OrderService.wsdl"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://www.examples.com/wsdl/OrderService.wsdl"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <!-- Messages -->
    <message name="PlaceOrderRequest">
        <part name="customerName" type="xsd:string"/>
        <part name="restaurantName" type="xsd:string"/>
        <part name="foodItems" type="xsd:string"/> <!-- Comma separated for simplicity in basic SOAP -->
        <part name="totalAmount" type="xsd:float"/>
    </message>
    <message name="PlaceOrderResponse">
        <part name="orderId" type="xsd:string"/>
        <part name="deliveryStatus" type="xsd:string"/>
    </message>

    <message name="GetOrderDetailsRequest">
        <part name="orderId" type="xsd:string"/>
    </message>
    <message name="GetOrderDetailsResponse">
        <part name="orderId" type="xsd:string"/>
        <part name="customerName" type="xsd:string"/>
        <part name="restaurantName" type="xsd:string"/>
        <part name="foodItems" type="xsd:string"/>
        <part name="totalAmount" type="xsd:float"/>
        <part name="deliveryStatus" type="xsd:string"/>
    </message>

    <message name="UpdateDeliveryStatusRequest">
        <part name="orderId" type="xsd:string"/>
        <part name="status" type="xsd:string"/>
    </message>
    <message name="UpdateDeliveryStatusResponse">
        <part name="orderId" type="xsd:string"/>
        <part name="deliveryStatus" type="xsd:string"/>
    </message>

    <message name="CancelOrderRequest">
        <part name="orderId" type="xsd:string"/>
    </message>
    <message name="CancelOrderResponse">
        <part name="orderId" type="xsd:string"/>
        <part name="deliveryStatus" type="xsd:string"/>
    </message>

    <!-- Port Type -->
    <portType name="OrderPortType">
        <operation name="placeOrder">
            <input message="tns:PlaceOrderRequest"/>
            <output message="tns:PlaceOrderResponse"/>
        </operation>
        <operation name="getOrderDetails">
            <input message="tns:GetOrderDetailsRequest"/>
            <output message="tns:GetOrderDetailsResponse"/>
        </operation>
        <operation name="updateDeliveryStatus">
            <input message="tns:UpdateDeliveryStatusRequest"/>
            <output message="tns:UpdateDeliveryStatusResponse"/>
        </operation>
        <operation name="cancelOrder">
            <input message="tns:CancelOrderRequest"/>
            <output message="tns:CancelOrderResponse"/>
        </operation>
    </portType>

    <!-- Binding -->
    <binding name="OrderBinding" type="tns:OrderPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        
        <operation name="placeOrder">
            <soap:operation soapAction="placeOrder"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="getOrderDetails">
            <soap:operation soapAction="getOrderDetails"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="updateDeliveryStatus">
            <soap:operation soapAction="updateDeliveryStatus"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>

        <operation name="cancelOrder">
            <soap:operation soapAction="cancelOrder"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <!-- Service -->
    <service name="OrderService">
        <port name="OrderPort" binding="tns:OrderBinding">
            <soap:address location="http://localhost:8000/wsdl"/>
        </port>
    </service>
</definitions>
